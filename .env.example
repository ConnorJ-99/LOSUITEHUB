# Copy this file to .env.local and fill in the DEV Supabase project's values
# (Supabase dashboard → Project Settings → API). Never use the production project.
# .env.local is ignored by git, so these values never get committed.
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key
# Must be exactly "development" or the app refuses to connect.
VITE_SUPABASE_ENV=development
