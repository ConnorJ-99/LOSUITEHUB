# Copy this file to .env.local and fill in the Supabase project's values
# (Supabase dashboard → Project Settings → API). .env.local is ignored by git,
# so these values never get committed.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# "development" on a computer; the live site (Vercel) sets "production".
# Anything else and the app refuses to connect.
VITE_SUPABASE_ENV=development
